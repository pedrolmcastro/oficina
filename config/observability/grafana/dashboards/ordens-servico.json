{
  "uid": "oficina-ordens-servico",
  "title": "Oficina — Ordens de serviço",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "oficina",
    "ordens-servico"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Volume, duração e erros HTTP de gestão de OS, insumos necessários, transições, reemissão de acesso, acompanhamento, decisão e páginas do cliente, incluindo todas as subrotas. Duração das operações transacionais por operação e erro. Médias ponderadas por requisição nos últimos 5 minutos; sem requisições na janela, a média fica sem dados. As rotas usam os templates da API, sem IDs, tokens ou dados pessoais nos rótulos.",
  "panels": [
    {
      "id": 1,
      "title": "Requisições por método e status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, status) (rate(http_server_requests_seconds_count{job=\"oficina\",uri=~\"/(ordens-servico|cliente)(/.*)?\"}[5m]))",
          "legendFormat": "{{method}} {{status}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Duração média HTTP",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_sum{job=\"oficina\",uri=~\"/(ordens-servico|cliente)(/.*)?\"}[5m])) / sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"oficina\",uri=~\"/(ordens-servico|cliente)(/.*)?\"}[5m]))",
          "legendFormat": "{{method}} {{uri}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Respostas 4xx e 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"oficina\",uri=~\"/(ordens-servico|cliente)(/.*)?\",status=~\"[45]..\"}[5m]))",
          "legendFormat": "{{status}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Duração por operação e erro",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operacao, error) (rate(ordens_servico_operacao_seconds_sum{job=\"oficina\"}[5m])) / sum by (operacao, error) (rate(ordens_servico_operacao_seconds_count{job=\"oficina\"}[5m]))",
          "legendFormat": "{{operacao}} {{error}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Tempo médio da criação até a entrega — últimas 24 horas",
      "type": "timeseries",
      "description": "Ciclo de vida completo das OS entregues, incluindo esperas, em uma janela móvel de 24 horas. Registrado após confirmar a entrega; não recupera entregas anteriores à implantação. Sem entregas na janela, a média fica sem dados.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ordens_servico_ciclo_seconds_sum{job=\"oficina\"}[24h])) / sum(increase(ordens_servico_ciclo_seconds_count{job=\"oficina\"}[24h]))",
          "legendFormat": "Criação até entrega",
          "instant": false,
          "range": true
        }
      ]
    }
  ]
}
