{
    "[java]": {
        "editor.defaultFormatter": "redhat.java",
    },
    "cucumber.features": [
        "src/bdd/resources/features/**/*.feature"
    ],
    "cucumber.glue": [
        "src/bdd/java/**/*.java"
    ],
    "java.checkstyle.configuration": "${workspaceFolder}/config/checkstyle/checkstyle.xml",
    "java.checkstyle.version": "14.3.0",
    "java.compile.nullAnalysis.mode": "automatic",
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.format.enabled": true,
    "java.format.settings.url": "config/formatter/java-formatter.xml",
    "java.format.settings.profile": "oficina",
    "sonarlint.connectedMode.project": {
        "connectionId": "pedrolmcastro",
        "projectKey": "pedrolmcastro_oficina"
    }
}
